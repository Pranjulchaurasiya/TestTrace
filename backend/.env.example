# TestTrace Backend Environment Configuration

# Database URL (SQLite default for local dev, PostgreSQL for Neon/Supabase/Render)
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=sqlite:///./testtrace.db

# JWT Secret for authentication tokens
JWT_SECRET=replace_with_a_long_random_secret_key_in_production

# Groq Cloud API Key for AI Code & Viva Explanation Auto-Evaluation
GROQ_API_KEY=gsk_your_groq_api_key_here
